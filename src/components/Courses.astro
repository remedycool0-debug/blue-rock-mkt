---
import { ArrowUpRight, Clock3, UsersRound } from '@lucide/astro';
import { courses } from '../data/site';
---

<section id="cursos" class="courses-section noise relative overflow-hidden bg-ink py-24 text-white md:py-32">
  <div class="pointer-events-none absolute -top-48 right-[-10%] h-[32rem] w-[32rem] rounded-full bg-electric/20 blur-[130px]"></div>
  <div class="container-shell relative">
    <div class="mb-16 grid items-end gap-10 lg:mb-24 lg:grid-cols-12">
      <h2 class="balance max-w-5xl text-[clamp(3.2rem,6vw,6.5rem)] font-[620] leading-[0.92] tracking-[-0.065em] lg:col-span-8">
        Aprende a decidir mejor.
      </h2>
      <div class="lg:col-span-4 lg:pl-8">
        <p class="max-w-md text-base leading-relaxed text-white/62">
          Formación práctica para equipos que quieren pensar con más claridad, ejecutar con método y conectar marketing con negocio.
        </p>
        <p class="mt-5 text-sm leading-relaxed text-white/38">
          Oferta formativa en preparación. Temarios y fechas sujetos a confirmación.
        </p>
      </div>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {courses.map((course) => (
        <a
          href={`/cursos#${course.slug}`}
          class="course-card group flex min-h-[39rem] flex-col overflow-hidden rounded-[2rem] border border-white/12 bg-white/[0.055] transition-transform duration-700 ease-out hover:-translate-y-2 focus-visible:outline-lime"
          aria-label={`Ver el programa de ${course.title}`}
        >
          <div class="relative h-64 shrink-0 overflow-hidden">
            <img
              class="course-image h-full w-full object-cover opacity-80 grayscale contrast-125 transition-transform duration-700 ease-out group-hover:scale-105"
              src={course.image}
              alt={`Composición editorial para el curso ${course.title}`}
              width="1200"
              height="900"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/5 to-transparent"></div>
            <span class="absolute top-5 left-5 rounded-full bg-lime px-4 py-2 text-xs font-semibold text-ink">
              Próxima edición
            </span>
          </div>

          <div class="flex flex-1 flex-col p-6 sm:p-8">
            <h3 class="balance text-[clamp(2rem,3vw,3rem)] font-[590] leading-[0.98] tracking-[-0.05em]">
              {course.title}
            </h3>
            <p class="mt-6 leading-relaxed text-white/58">{course.description}</p>

            <div class="mt-8 grid gap-3 border-t border-white/12 pt-6 text-sm text-white/48">
              <span class="flex items-center gap-3">
                <UsersRound class="h-4 w-4 shrink-0 text-lime" />
                {course.audience}
              </span>
              <span class="flex items-center gap-3">
                <Clock3 class="h-4 w-4 shrink-0 text-lime" />
                {course.duration} · {course.level}
              </span>
            </div>

            <span class="mt-auto flex min-h-12 items-end justify-between gap-5 pt-10 font-semibold text-lime">
              Ver el programa
              <ArrowUpRight class="h-5 w-5 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
