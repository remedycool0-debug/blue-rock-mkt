---
import { ArrowDown, ArrowUpRight } from '@lucide/astro';
---

<section id="inicio" class="hero noise relative min-h-[100svh] overflow-hidden bg-ink text-white">
  <img
    class="hero-image absolute inset-0 h-full w-full object-cover opacity-50 grayscale contrast-125"
    src="https://picsum.photos/seed/bluerock-cinematic/1920/1080"
    alt="Arquitectura contemporánea que evoca dirección, precisión y crecimiento"
    width="1920"
    height="1080"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,rgba(40,100,255,.18),transparent_32%),linear-gradient(180deg,rgba(7,24,45,.35)_0%,rgba(7,24,45,.84)_72%,#07182d_100%)]"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>

  <div class="container-shell relative z-10 flex min-h-[100svh] flex-col items-center justify-center pb-16 pt-36 text-center sm:pt-40">
    <p class="hero-kicker mb-7 max-w-xl text-sm font-medium leading-relaxed text-white/68 sm:text-base">
      Estrategia, contenido y demanda para empresas que venden soluciones complejas.
    </p>

    <h1 class="hero-title max-w-6xl text-[clamp(3.8rem,7.6vw,7.4rem)] font-[650] leading-[0.88] tracking-[-0.07em]">
      <span class="hidden sm:block">Impulsamos marcas B2B</span>
      <span class="hidden text-white/78 sm:block">que crecen con dirección</span>
      <span class="block text-[clamp(2.2rem,10vw,3.5rem)] sm:hidden">Impulsamos marcas</span>
      <span class="block text-[clamp(2.2rem,10vw,3.5rem)] sm:hidden">B2B que crecen</span>
      <span class="block text-[clamp(2.2rem,10vw,3.5rem)] text-white/78 sm:hidden">con dirección</span>
    </h1>

    <p class="hero-copy balance mt-8 max-w-2xl text-base leading-relaxed text-white/66 sm:text-lg">
      BlueRock convierte ambición comercial en un sistema de marketing claro, medible y conectado con ventas.
    </p>

    <div class="hero-actions mt-10 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
      <a class="button-primary group" href="#contacto">
        Solicitar diagnóstico
        <ArrowUpRight class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
      <a class="button-secondary group" href="#servicios">
        Explorar servicios
        <ArrowDown class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-1" />
      </a>
    </div>

    <div class="absolute bottom-7 left-1/2 flex -translate-x-1/2 items-center gap-3 text-[0.68rem] font-medium tracking-[0.2em] text-white/45 uppercase">
      <span class="h-px w-8 bg-white/25"></span>
      Pensar antes de escalar
      <span class="h-px w-8 bg-white/25"></span>
    </div>
  </div>
</section>
