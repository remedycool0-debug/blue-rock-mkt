---
import { ArrowUpRight } from '@lucide/astro';
import type { InsightArticle } from '../types';

interface Props {
  article: InsightArticle;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
---

<a
  href={`/insights/${article.slug}`}
  class:list={[
    'group stack-card flex h-full flex-col overflow-hidden rounded-[2rem] border border-ink/10 bg-white text-ink',
    featured && 'md:grid md:grid-cols-2',
  ]}
>
  <div class:list={['relative overflow-hidden', featured ? 'min-h-[26rem]' : 'aspect-[4/3]']}>
    <img
      class="reveal-image h-full w-full object-cover grayscale contrast-125 transition-transform duration-700 ease-out group-hover:scale-105"
      src={article.image}
      alt={`Imagen editorial para ${article.title}`}
      width="1400"
      height="900"
      loading="lazy"
    />
  </div>
  <div class="flex flex-1 flex-col justify-between p-6 sm:p-8">
    <div class="flex items-start justify-between gap-5">
      <div>
        <p class="text-sm font-semibold text-electric">{article.category}</p>
        <p class="mt-2 text-xs text-ink/42">{article.readingTime}</p>
      </div>
      <ArrowUpRight class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1" />
    </div>
    <div class="mt-14">
      <h2 class:list={['balance font-[620] leading-[1.02] tracking-[-0.05em]', featured ? 'text-[clamp(2.5rem,4vw,4.5rem)]' : 'text-[clamp(2rem,3vw,3rem)]']}>
        {article.title}
      </h2>
      <p class="mt-5 leading-relaxed text-ink/58">{article.excerpt}</p>
    </div>
  </div>
</a>
