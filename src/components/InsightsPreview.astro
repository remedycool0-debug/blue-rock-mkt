---
import { ArrowRight } from '@lucide/astro';
import { insights } from '../data/site';
import InsightCard from './InsightCard.astro';
---

<section class="bg-[#dce4e4] py-24 md:py-32">
  <div class="container-shell">
    <div class="mb-16 flex flex-col justify-between gap-8 md:mb-24 md:flex-row md:items-end">
      <h2 class="balance max-w-4xl text-[clamp(3.2rem,6vw,6.5rem)] font-[620] leading-[0.92] tracking-[-0.065em]">
        Ideas que ayudan a decidir mejor.
      </h2>
      <a href="/insights" class="group inline-flex items-center gap-3 text-sm font-semibold text-ink">
        Ver todos los insights
        <ArrowRight class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {insights.map((article) => <InsightCard article={article} />)}
    </div>
  </div>
</section>
