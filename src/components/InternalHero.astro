---
import { ArrowDown } from '@lucide/astro';

interface Props {
  title: string;
  intro: string;
  image: string;
  context: string;
}

const { title, intro, image, context } = Astro.props;
---

<section class="internal-hero noise relative min-h-[88svh] overflow-hidden bg-ink text-white">
  <img
    class="reveal-image absolute inset-0 h-full w-full object-cover opacity-45 grayscale contrast-125"
    src={image}
    alt="Composición editorial de BlueRock"
    width="1920"
    height="1080"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_30%,rgba(40,100,255,.22),transparent_35%),linear-gradient(180deg,rgba(7,24,45,.28),#07182d_96%)]"></div>
  <div class="container-shell relative z-10 flex min-h-[88svh] flex-col justify-end pb-16 pt-40 md:pb-24">
    <p class="mb-6 text-sm font-semibold text-lime">{context}</p>
    <h1 class="balance max-w-6xl text-[clamp(1.95rem,8.8vw,4rem)] font-[650] leading-[0.9] tracking-[-0.065em] sm:text-[clamp(3.5rem,7.7vw,8rem)] sm:leading-[0.88] sm:tracking-[-0.07em]">
      {title}
    </h1>
    <div class="mt-10 flex flex-col gap-8 border-t border-white/18 pt-7 md:flex-row md:items-end md:justify-between">
      <p class="max-w-2xl text-lg leading-relaxed text-white/64">{intro}</p>
      <a href="#contenido" class="group inline-flex shrink-0 items-center gap-3 text-sm font-semibold text-white">
        Seguir explorando
        <span class="grid h-11 w-11 place-items-center rounded-full border border-white/25 transition-colors group-hover:bg-white group-hover:text-ink">
          <ArrowDown class="h-4 w-4" />
        </span>
      </a>
    </div>
  </div>
</section>
