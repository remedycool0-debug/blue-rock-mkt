---
const statement = 'Conectamos lo que tu marca promete con lo que tu equipo comercial necesita para avanzar.';
const words = statement.split(' ');
---

<section class="manifesto noise relative overflow-hidden bg-ink py-24 text-white md:py-32">
  <div class="absolute -left-48 top-0 h-[36rem] w-[36rem] rounded-full bg-electric/18 blur-[130px]"></div>
  <div class="container-shell relative z-10">
    <h2 class="balance max-w-6xl text-[clamp(3.2rem,7vw,7rem)] font-[600] leading-[0.96] tracking-[-0.07em]">
      El crecimiento
      <span
        class="mx-2 inline-block h-[0.66em] w-[1.35em] translate-y-[0.02em] overflow-hidden rounded-full bg-cover bg-center align-baseline sm:mx-4"
        style="background-image: url('https://picsum.photos/seed/bluerock-inline/700/400')"
        role="img"
        aria-label="Detalle visual de una estructura mineral"
      ></span>
      no aparece por azar.
    </h2>

    <p class="manifesto-copy mt-20 max-w-6xl text-[clamp(2rem,4.7vw,5rem)] font-[480] leading-[1.08] tracking-[-0.055em] md:mt-32">
      {words.map((word) => <span class="manifesto-word mr-[0.22em] inline-block text-white">{word}</span>)}
    </p>
  </div>
</section>
