---
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  title?: string;
  copy?: string;
}

const {
  title = 'La próxima decisión puede ordenar todo lo que viene después.',
  copy = 'Cuéntanos qué quieres mover y diseñaremos una primera lectura del reto.',
} = Astro.props;
---

<section class="bg-mineral py-20 md:py-28">
  <div class="container-shell">
    <div class="noise relative overflow-hidden rounded-[2.5rem] bg-electric px-6 py-16 text-white sm:px-10 md:px-16 md:py-24">
      <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-lime/18 blur-[100px]"></div>
      <div class="relative z-10 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="balance max-w-5xl text-[clamp(3rem,6vw,6.4rem)] font-[630] leading-[0.92] tracking-[-0.065em]">{title}</h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/68">{copy}</p>
        </div>
        <a href="/contacto" class="button-primary group shrink-0">
          Solicitar diagnóstico
          <ArrowUpRight class="h-4 w-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
        </a>
      </div>
    </div>
  </div>
</section>
