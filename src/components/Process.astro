---
import { ArrowDownRight } from '@lucide/astro';

const steps = [
  {
    title: 'Entender el negocio',
    copy: 'Alineamos mercado, oferta, objetivos y fricciones antes de recomendar una sola acción.',
  },
  {
    title: 'Elegir las palancas',
    copy: 'Priorizamos los mensajes, canales y activos con mayor capacidad de mover oportunidades.',
  },
  {
    title: 'Construir el sistema',
    copy: 'Conectamos contenido, campañas, conversión y seguimiento en una operación coherente.',
  },
  {
    title: 'Medir para decidir',
    copy: 'Leemos señales comerciales, aprendemos rápido y concentramos inversión donde hay avance.',
  },
];
---

<section id="metodo" class="process-section bg-[#dce4e4] py-24 md:py-32">
  <div class="container-shell process-grid grid gap-16 lg:grid-cols-12 lg:gap-10">
    <div class="process-copy self-start lg:col-span-5 lg:pr-12">
      <h2 class="balance text-[clamp(3.2rem,6vw,6.5rem)] font-[620] leading-[0.92] tracking-[-0.065em]">
        Claridad en cada decisión.
      </h2>
      <p class="mt-8 max-w-md text-lg leading-relaxed text-ink/62">
        Un método pensado para avanzar con foco, demostrar aprendizaje y hacer que marketing y ventas operen como un solo equipo.
      </p>
      <a href="#contacto" class="mt-9 inline-flex items-center gap-2 border-b border-ink pb-1 text-sm font-semibold">
        Conversar sobre tu reto
        <ArrowDownRight class="h-4 w-4" />
      </a>
    </div>

    <div class="space-y-4 lg:col-span-7">
      {steps.map((step, index) => (
        <article class="process-step group flex min-h-[20rem] flex-col justify-between overflow-hidden rounded-[2rem] border border-ink/10 bg-mineral p-6 transition-transform duration-700 ease-out hover:-translate-y-1 sm:p-9">
          <div class="flex items-start justify-between gap-6">
            <span class="grid h-12 w-12 place-items-center rounded-full bg-ink font-semibold text-white">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="h-3 w-3 rotate-45 bg-electric transition-transform duration-500 group-hover:rotate-[135deg]"></span>
          </div>
          <div>
            <h3 class="text-[clamp(2.2rem,4vw,4.6rem)] font-[610] leading-none tracking-[-0.06em]">{step.title}</h3>
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink/58 sm:text-lg">{step.copy}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
