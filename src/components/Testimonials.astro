---
import { ArrowLeft, ArrowRight, Quote } from '@lucide/astro';
import { testimonials } from '../data/site';
---

<section class="overflow-hidden bg-mineral pb-24 md:pb-32">
  <div class="container-shell rounded-[2.5rem] bg-electric p-6 text-white sm:p-10 lg:p-16">
    <div class="grid gap-14 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-4">
        <Quote class="h-12 w-12 text-lime" stroke-width={1.5} />
        <h2 class="balance mt-8 text-[clamp(2.6rem,4.5vw,5rem)] font-[610] leading-[0.98] tracking-[-0.06em]">
          Lo que podría sentirse al trabajar juntos.
        </h2>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-white/64">
          Testimonios conceptuales. No representan declaraciones de clientes reales.
        </p>
      </div>

      <div class="testimonial-carousel min-w-0 lg:col-span-8" aria-roledescription="carrusel" aria-label="Testimonios conceptuales">
        <div class="relative min-h-[26rem] rounded-[2rem] bg-white p-6 text-ink sm:p-10">
          {testimonials.map((testimonial, index) => (
            <article
              class="testimonial-slide flex h-full min-h-[21rem] flex-col justify-between"
              data-slide={index}
              aria-hidden={index === 0 ? 'false' : 'true'}
              hidden={index !== 0}
            >
              <blockquote class="balance text-[clamp(2rem,3.8vw,4rem)] font-[520] leading-[1.05] tracking-[-0.055em]">
                “{testimonial.quote}”
              </blockquote>
              <div class="mt-10 flex items-center gap-4">
                <img
                  class="h-14 w-14 rounded-full object-cover grayscale contrast-125"
                  src={testimonial.image}
                  alt="Retrato de perfil"
                  width="400"
                  height="400"
                  loading="lazy"
                />
                <div>
                  <p class="font-semibold">{testimonial.role}</p>
                  <p class="text-sm text-ink/48">{testimonial.company}</p>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-5 flex items-center justify-between">
          <p class="carousel-status text-sm font-medium text-white/65" aria-live="polite">
            1 de {testimonials.length}
          </p>
          <div class="flex gap-2">
            <button class="carousel-prev grid h-12 w-12 place-items-center rounded-full border border-white/30 transition hover:bg-white hover:text-electric" type="button" aria-label="Testimonio anterior">
              <ArrowLeft class="h-5 w-5" />
            </button>
            <button class="carousel-next grid h-12 w-12 place-items-center rounded-full border border-white/30 transition hover:bg-white hover:text-electric" type="button" aria-label="Siguiente testimonio">
              <ArrowRight class="h-5 w-5" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.testimonial-slide'));
  const previousButton = document.querySelector<HTMLButtonElement>('.carousel-prev');
  const nextButton = document.querySelector<HTMLButtonElement>('.carousel-next');
  const status = document.querySelector<HTMLElement>('.carousel-status');
  const slideCount = slides.length;
  let activeSlide = 0;

  function showSlide(nextIndex: number) {
    activeSlide = (nextIndex + slideCount) % slideCount;
    slides.forEach((slide, index) => {
      const isActive = index === activeSlide;
      slide.hidden = !isActive;
      slide.setAttribute('aria-hidden', String(!isActive));
    });
    if (status) status.textContent = `${activeSlide + 1} de ${slideCount}`;
  }

  previousButton?.addEventListener('click', () => showSlide(activeSlide - 1));
  nextButton?.addEventListener('click', () => showSlide(activeSlide + 1));
</script>
