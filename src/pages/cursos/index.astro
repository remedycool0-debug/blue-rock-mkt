---
import { ArrowDown, ArrowUpRight, Check, Clock3, UsersRound } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Marquee from '../../components/Marquee.astro';
import PageCTA from '../../components/PageCTA.astro';
import PageMotion from '../../components/PageMotion.astro';
import { courses } from '../../data/site';

const learningPrinciples = [
  {
    title: 'Contexto antes que recetas',
    copy: 'Cada concepto parte de un reto comercial reconocible para entender cuándo usarlo, cuándo adaptarlo y cuándo descartarlo.',
  },
  {
    title: 'Herramientas para aplicar',
    copy: 'Los marcos se convierten en decisiones, plantillas y ejercicios que el equipo puede llevar a su operación desde el primer módulo.',
  },
  {
    title: 'Un proyecto que integra',
    copy: 'Cada programa termina con una pieza de trabajo útil para ordenar una prioridad real de marketing o crecimiento.',
  },
];

const questions = [
  {
    question: '¿Los cursos ya están disponibles?',
    answer: 'La oferta se encuentra en preparación. Puedes registrar tu interés para recibir primero las fechas, modalidad y temario definitivo.',
  },
  {
    question: '¿Están pensados para personas o para equipos?',
    answer: 'La estructura funciona para aprendizaje individual y también puede adaptarse a una cohorte privada para equipos de marketing, ventas o dirección.',
  },
  {
    question: '¿Necesito experiencia previa en marketing B2B?',
    answer: 'Cada programa indica su nivel. Posicionamiento admite perfiles que recién empiezan; estrategia y automatización aprovechan mejor cierta experiencia profesional.',
  },
  {
    question: '¿Qué modalidad tendrán?',
    answer: 'La modalidad y calendario se confirmarán con cada edición. La intención es combinar contenido guiado, sesiones aplicadas y material de trabajo reutilizable.',
  },
];
---

<BaseLayout
  title="Cursos de marketing B2B | BlueRock"
  description="Formación práctica en estrategia, posicionamiento, performance y automatización comercial para profesionales y equipos B2B."
>
  <Header />
  <main class="w-full max-w-full overflow-x-hidden">
    <section class="noise relative min-h-[92svh] overflow-hidden bg-ink pt-28 text-white">
      <div class="pointer-events-none absolute -left-56 top-24 h-[34rem] w-[34rem] rounded-full bg-electric/20 blur-[140px]"></div>
      <div class="container-shell relative grid min-h-[calc(92svh-7rem)] items-center gap-14 py-16 lg:grid-cols-12 lg:py-20">
        <div class="lg:col-span-7 lg:pr-8">
          <p class="mb-7 max-w-xl text-base font-medium leading-relaxed text-lime">Formación BlueRock para profesionales y equipos B2B</p>
          <h1 class="balance max-w-5xl text-[clamp(2.55rem,5.1vw,5.3rem)] font-[650] leading-[0.92] tracking-[-0.065em]">
            Convierte marketing en decisiones de negocio.
          </h1>
          <p class="mt-8 max-w-2xl text-lg leading-relaxed text-white/64">
            Programas aplicados para pensar con criterio, construir sistemas útiles y llevar cada aprendizaje a un reto comercial concreto.
          </p>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row">
            <a class="button-primary group" href="#catalogo">
              Explorar programas
              <ArrowDown class="h-4 w-4 transition-transform group-hover:translate-y-1" />
            </a>
            <a class="button-secondary border-white/25 !text-white hover:!bg-white hover:!text-ink" href="/contacto">
              Consultar una edición
            </a>
          </div>
        </div>

        <div class="relative min-h-[30rem] overflow-hidden rounded-[2rem] border border-white/14 lg:col-span-5 lg:min-h-[38rem]">
          <img
            class="reveal-image absolute inset-0 h-full w-full object-cover opacity-80 grayscale contrast-125 transition-transform duration-700 ease-out hover:scale-105"
            src="https://picsum.photos/seed/bluerock-courses-hero/1200/1500"
            alt="Composición editorial para la formación BlueRock"
            width="1200"
            height="1500"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-ink/20"></div>
          <p class="absolute inset-x-0 bottom-0 p-7 text-sm leading-relaxed text-white/72 sm:p-9">
            Aprender para decidir mejor, no para acumular teoría.
          </p>
        </div>
      </div>
    </section>

    <Marquee />

    <section id="catalogo" class="bg-mineral py-24 md:py-32">
      <div class="container-shell">
        <div class="mb-16 grid items-end gap-8 md:mb-24 lg:grid-cols-12">
          <h2 class="balance max-w-5xl text-[clamp(3.2rem,6vw,6.5rem)] font-[630] leading-[0.92] tracking-[-0.065em] lg:col-span-8">
            Elige el reto que quieres aprender a resolver.
          </h2>
          <p class="max-w-md text-lg leading-relaxed text-ink/58 lg:col-span-4">
            Tres programas en preparación, diseñados alrededor de decisiones que un equipo B2B necesita tomar bien.
          </p>
        </div>

        <div class="horizontal-accordion flex flex-col gap-4 lg:h-[46rem] lg:flex-row">
          {courses.map((course) => (
            <article id={course.slug} class="course-program group relative min-h-[42rem] flex-1 scroll-mt-24 overflow-hidden rounded-[2rem] bg-ink text-white transition-[flex,transform] duration-700 ease-out hover:-translate-y-1 lg:min-h-0 lg:hover:flex-[1.6]">
              <img
                class="reveal-image absolute inset-0 h-full w-full object-cover opacity-55 grayscale contrast-125 transition-transform duration-700 ease-out group-hover:scale-105"
                src={course.image}
                alt={`Dirección visual para ${course.title}`}
                width="1200"
                height="900"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/75 to-ink/10"></div>
              <div class="absolute inset-0 z-10 flex flex-col justify-between p-6 sm:p-8">
                <div class="flex items-start justify-between gap-5">
                  <span class="rounded-full bg-lime px-4 py-2 text-xs font-semibold text-ink">Próxima edición</span>
                  <ArrowUpRight class="h-6 w-6 transition-transform duration-500 group-hover:translate-x-1 group-hover:-translate-y-1" />
                </div>

                <div>
                  <h3 class="balance max-w-2xl text-[clamp(2.5rem,4.4vw,5.4rem)] font-[620] leading-[0.94] tracking-[-0.06em]">{course.title}</h3>
                  <p class="mt-5 max-w-xl leading-relaxed text-white/64">{course.description}</p>

                  <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 border-t border-white/15 pt-5 text-sm text-white/52">
                    <span class="flex items-center gap-2"><UsersRound class="h-4 w-4 text-lime" />{course.audience}</span>
                    <span class="flex items-center gap-2"><Clock3 class="h-4 w-4 text-lime" />{course.duration} · {course.level}</span>
                  </div>

                  <ul class="mt-6 grid gap-2 text-sm text-white/72">
                    {course.outcomes.map((outcome) => (
                      <li class="flex items-start gap-3"><Check class="mt-0.5 h-4 w-4 shrink-0 text-lime" />{outcome}</li>
                    ))}
                  </ul>

                  <a class="mt-7 inline-flex min-h-12 items-center gap-3 font-semibold text-lime" href={`/contacto?curso=${course.slug}`}>
                    Quiero conocer la próxima edición
                    <ArrowUpRight class="h-4 w-4" />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="learning-section noise relative overflow-hidden bg-ink py-24 text-white md:py-32">
      <div class="pointer-events-none absolute -right-56 top-24 h-[36rem] w-[36rem] rounded-full bg-electric/18 blur-[140px]"></div>
      <div class="learning-grid container-shell relative grid gap-16 lg:grid-cols-12 lg:gap-10">
        <div class="learning-copy self-start lg:col-span-5 lg:pr-12">
          <h2 class="balance text-[clamp(3.2rem,6vw,6.5rem)] font-[620] leading-[0.92] tracking-[-0.065em]">
            Aprender haciendo cambia la conversación.
          </h2>
          <p class="mt-8 max-w-md text-lg leading-relaxed text-white/58">
            El objetivo no es memorizar conceptos. Es salir con una decisión mejor formulada y una herramienta que el equipo pueda seguir usando.
          </p>
        </div>

        <div class="space-y-5 lg:col-span-7">
          {learningPrinciples.map((principle, index) => (
            <article class="course-method-card stack-card sticky min-h-[25rem] rounded-[2rem] border border-white/12 bg-[#0b2441] p-7 shadow-[0_-24px_80px_rgba(0,0,0,.24)] sm:p-10" style={`top: ${7 + index * 1.4}rem`}>
              <div class="flex min-h-[20rem] flex-col justify-between">
                <span class="grid h-12 w-12 place-items-center rounded-full border border-white/18 text-sm font-semibold text-lime">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="balance text-[clamp(2.4rem,4.5vw,5rem)] font-[610] leading-[0.96] tracking-[-0.06em]">{principle.title}</h3>
                  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/58">{principle.copy}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#dce4e4] py-24 md:py-32">
      <div class="container-shell grid gap-14 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="balance text-[clamp(3.2rem,6vw,6rem)] font-[620] leading-[0.92] tracking-[-0.065em]">Antes de elegir un curso.</h2>
          <p class="mt-7 max-w-md text-lg leading-relaxed text-ink/58">Lo esencial sobre disponibilidad, perfiles y modalidad de las próximas ediciones.</p>
        </div>
        <div class="divide-y divide-ink/12 border-y border-ink/12 lg:col-span-7">
          {questions.map((item) => (
            <details class="group py-6">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-6 text-xl font-semibold marker:content-none">
                {item.question}
                <span class="relative h-8 w-8 shrink-0 rounded-full border border-ink/20 after:absolute after:top-1/2 after:left-1/2 after:h-px after:w-3 after:-translate-x-1/2 after:-translate-y-1/2 after:bg-ink before:absolute before:top-1/2 before:left-1/2 before:h-3 before:w-px before:-translate-x-1/2 before:-translate-y-1/2 before:bg-ink before:transition-transform group-open:before:rotate-90"></span>
              </summary>
              <p class="max-w-2xl pt-4 pr-12 leading-relaxed text-ink/58">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <PageCTA
      title="Cuando el aprendizaje se aplica, la siguiente decisión cambia."
      copy="Cuéntanos qué programa te interesa y te avisaremos cuando la próxima edición esté lista."
    />
  </main>
  <Footer />
  <PageMotion />
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const media = gsap.matchMedia();

  media.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    ScrollTrigger.create({
      trigger: '.learning-grid',
      start: 'top 16%',
      end: 'bottom 78%',
      pin: '.learning-copy',
      pinSpacing: false,
    });

    gsap.utils.toArray<HTMLElement>('.course-method-card').forEach((card, index) => {
      gsap.to(card, {
        scale: 1 - index * 0.018,
        ease: 'none',
        scrollTrigger: {
          trigger: card,
          start: 'top 34%',
          end: 'bottom 18%',
          scrub: 1,
        },
      });
    });
  });

  window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
</script>

<style>
  @media (prefers-reduced-motion: reduce) {
    .course-method-card {
      position: relative;
      top: auto !important;
    }
  }
</style>
