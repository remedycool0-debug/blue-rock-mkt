---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InternalHero from '../components/InternalHero.astro';
import PageCTA from '../components/PageCTA.astro';
import PageMotion from '../components/PageMotion.astro';

const principles = [
  { title: 'Primero entendemos', copy: 'La velocidad no sirve si el equipo corre hacia el problema equivocado.' },
  { title: 'Después conectamos', copy: 'Marca, demanda y ventas deben reforzar la misma historia comercial.' },
  { title: 'Finalmente escalamos', copy: 'Solo ampliamos lo que demuestra aprendizaje y capacidad de avanzar.' },
];
---

<BaseLayout title="Estudio | BlueRock Marketing" description="Conoce cómo piensa y trabaja BlueRock para conectar marketing B2B con crecimiento comercial.">
  <Header />
  <main class="w-full max-w-full overflow-x-hidden">
    <InternalHero
      context="El estudio"
      title="Pensamos como negocio. Ejecutamos como equipo."
      intro="BlueRock nace para resolver una tensión simple: demasiadas acciones de marketing y muy poca claridad sobre lo que realmente mueve el negocio."
      image="https://picsum.photos/seed/bluerock-studio-hero/1920/1080"
    />

    <section id="contenido" class="bg-mineral py-24 md:py-32">
      <div class="container-shell">
        <p class="balance max-w-6xl text-[clamp(3rem,6.2vw,6.7rem)] font-[560] leading-[1.02] tracking-[-0.065em]">
          Somos un estudio de crecimiento B2B que combina pensamiento estratégico, criterio creativo y disciplina operativa.
        </p>
        <div class="mt-20 grid gap-8 border-t border-ink/12 pt-10 md:grid-cols-2 md:mt-32">
          <p class="max-w-xl text-xl leading-relaxed text-ink/72">Trabajamos mejor con empresas que tienen una solución valiosa, un ciclo comercial exigente y la ambición de construir una presencia que esté a la altura de su negocio.</p>
          <p class="max-w-xl text-xl leading-relaxed text-ink/72 md:justify-self-end">No llegamos con una receta cerrada. Diagnosticamos, priorizamos y armamos el sistema mínimo que permita aprender, demostrar impacto y crecer con control.</p>
        </div>
      </div>
    </section>

    <section class="bg-ink py-24 text-white md:py-32">
      <div class="container-shell">
        <h2 class="balance mb-20 max-w-5xl text-[clamp(3.2rem,6vw,6.5rem)] font-[620] leading-[0.92] tracking-[-0.065em]">Tres principios sostienen nuestra forma de trabajar.</h2>
        <div class="space-y-5">
          {principles.map((principle, index) => (
            <article class="stack-card sticky min-h-[28rem] rounded-[2rem] border border-white/12 bg-[#0b2441] p-7 shadow-[0_-24px_80px_rgba(0,0,0,.25)] sm:p-12" style={`top: ${7 + index * 1.5}rem`}>
              <div class="flex h-full min-h-[22rem] flex-col justify-between">
                <span class="h-3 w-3 rotate-45 bg-lime"></span>
                <div>
                  <h3 class="text-[clamp(3rem,6vw,6.5rem)] font-[620] leading-none tracking-[-0.065em]">{principle.title}</h3>
                  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/60">{principle.copy}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <PageCTA title="Si el reto merece una mirada distinta, empecemos por entenderlo." />
  </main>
  <Footer />
  <PageMotion />
</BaseLayout>
