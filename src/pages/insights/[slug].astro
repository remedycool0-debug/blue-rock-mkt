---
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageCTA from '../../components/PageCTA.astro';
import PageMotion from '../../components/PageMotion.astro';
import { insights } from '../../data/site';
import type { InsightArticle } from '../../types';

export function getStaticPaths() {
  return insights.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
  article: InsightArticle;
}

const { article } = Astro.props;
---

<BaseLayout title={`${article.title} | BlueRock Insights`} description={article.excerpt}>
  <Header />
  <main class="w-full max-w-full overflow-x-hidden">
    <article>
      <header class="noise relative overflow-hidden bg-ink pb-20 pt-40 text-white md:pb-28 md:pt-48">
        <div class="absolute right-0 top-0 h-[32rem] w-[32rem] rounded-full bg-electric/20 blur-[130px]"></div>
        <div class="container-shell relative z-10">
          <a href="/insights" class="mb-12 inline-flex items-center gap-2 text-sm font-semibold text-white/64 transition-colors hover:text-white"><ArrowLeft class="h-4 w-4" /> Volver a insights</a>
          <p class="text-sm font-semibold text-lime">{article.category} · {article.readingTime}</p>
          <h1 class="balance mt-7 max-w-6xl text-[clamp(1.95rem,8.8vw,3.8rem)] font-[640] leading-[0.94] tracking-[-0.065em] sm:text-[clamp(3.4rem,7vw,7.4rem)] sm:leading-[0.9] sm:tracking-[-0.07em]">{article.title}</h1>
          <p class="mt-10 text-sm text-white/45">Publicado el {article.publishedAt}</p>
        </div>
      </header>

      <figure class="bg-ink px-4 pb-4 sm:px-6 sm:pb-6">
        <div class="mx-auto max-w-[96rem] overflow-hidden rounded-[2rem]">
          <img class="reveal-image aspect-[16/7] w-full object-cover grayscale contrast-125" src={article.image} alt={`Imagen editorial para ${article.title}`} width="1800" height="900" />
        </div>
      </figure>

      <div class="bg-mineral py-28 md:py-40">
        <div class="container-shell grid gap-12 lg:grid-cols-12">
          <aside class="lg:col-span-3">
            <p class="sticky top-32 max-w-xs text-sm leading-relaxed text-ink/48">Una perspectiva de BlueRock sobre crecimiento B2B. Contenido editorial demostrativo.</p>
          </aside>
          <div class="lg:col-span-7 lg:col-start-5">
            <p class="balance text-[clamp(2rem,3.4vw,3.7rem)] font-[520] leading-[1.12] tracking-[-0.045em]">{article.introduction}</p>
            {article.sections.map((section) => (
              <section class="mt-20 border-t border-ink/12 pt-10">
                <h2 class="balance text-[clamp(2.4rem,4vw,4.4rem)] font-[620] leading-[1] tracking-[-0.055em]">{section.title}</h2>
                {section.paragraphs.map((paragraph) => <p class="mt-7 text-lg leading-[1.75] text-ink/68">{paragraph}</p>)}
              </section>
            ))}
            <blockquote class="my-20 rounded-[2rem] bg-electric p-7 text-[clamp(2rem,3.6vw,4rem)] font-[590] leading-[1.06] tracking-[-0.05em] text-white sm:p-11">
              {article.takeaway}
            </blockquote>
          </div>
        </div>
      </div>
    </article>
    <PageCTA />
  </main>
  <Footer />
  <PageMotion />
</BaseLayout>
